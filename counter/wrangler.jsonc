{
  "name": "snowsadh-visits",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "assets": {
    "directory": "../assets",
    "binding": "ARTWORK",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "VISITS", "class_name": "Visits" }]
  },
  "exports": {
    "Visits": { "type": "durable-object", "storage": "sqlite" }
  }
}
